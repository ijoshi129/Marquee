# =============================================================
# Marquee configuration
#
# Variables marked [REQUIRED] must be set before first launch.
# Variables marked [OPTIONAL] are safe to leave at the defaults.
# Variables marked [DO NOT TOUCH] are internal plumbing — changing
# them will break the app.
# =============================================================


# --- Postgres (bundled in docker-compose) ---

# [DO NOT TOUCH] Used by docker-compose and to construct the connection URL.
POSTGRES_USER=marqueeadmin

# [REQUIRED] Strong password for the bundled Postgres. The connection URL
# is built from this automatically — you only need to set it here.
POSTGRES_PASSWORD=ChangeThisToASecurePassword

# [DO NOT TOUCH] Database name. Used to construct the connection URL.
POSTGRES_DB=marquee

# [OPTIONAL] Host port the bundled Postgres exposes. 5433 to avoid
# clashing with any existing Postgres on the host. Change only if
# 5433 is taken on your machine.
POSTGRES_HOST_PORT=5433


# --- Server ---

# [DO NOT TOUCH] Port the Node server listens on inside the container.
# Always 3000. To change which port your machine sees, change
# APP_HOST_PORT below — not this.
PORT=3000

# [OPTIONAL] Port on YOUR machine that maps to the container's 3000.
# Change only if port 3000 is already taken on your host. You'll then
# visit http://localhost:<this-port>.
APP_HOST_PORT=3000

# [DO NOT TOUCH] Standard Node convention. The docker-compose file
# overrides this to "production" automatically. Leave as "development"
# here for local `npm run dev`.
NODE_ENV=development

# [DO NOT TOUCH] Dev-mode-only CORS allowlist for the Vite dev server
# (which serves the client on :5173). Ignored in production / Docker.
CLIENT_URL=http://localhost:5173

# [OPTIONAL] Log verbosity: trace | debug | info | warn | error.
# Leave blank for sensible defaults (debug in dev, info in production).
# Bump to "debug" while troubleshooting.
LOG_LEVEL=


# --- Backups ---

# [DO NOT TOUCH] Path inside the container where dumps are written.
# To change where they end up on YOUR machine, change BACKUP_HOST_PATH
# below — not this. Set blank only if you want to fully disable
# automated backups (not recommended).
BACKUP_DIR=/backups

# [OPTIONAL] How many days of backups to keep. Older files are pruned
# automatically so the directory doesn't grow forever. Default 30.
BACKUP_RETENTION_DAYS=30

# [REQUIRED for production] Host path mounted to /backups inside the
# container. Set this to a path on DURABLE storage (a different drive
# than your DB volume, ideally) so backups survive container deletes
# AND host disk failures. Examples:
#   Unraid:        /mnt/user/appdata/marquee/backups
#   macOS / Linux: /Users/you/marquee-backups
#   External:      /Volumes/Backup/marquee
BACKUP_HOST_PATH=./backups


# --- TMDB ---

# [REQUIRED]
# How to get one: https://www.themoviedb.org → Settings → API →
# Request a Developer key. Free, instant approval. Use the v3 API key
# (32 chars).
TMDB_API_KEY=


# --- Trakt.tv sync ---

# [OPTIONAL] Leave blank to disable Trakt sync entirely.
# When configured, watched movies are added to your Trakt history in the
# background after they are confirmed as seen. Marquee sends the watch's
# booked showtime as Trakt's watched_at timestamp.
#
# Create an app at https://trakt.tv/oauth/applications. Add every URL where
# you access Marquee to the Trakt app's Redirect URI and JavaScript origin
# fields: local URLs such as http://localhost:3000, and any reverse-proxy
# public URL such as https://marquee.example.com.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://localhost:3000

# [OPTIONAL, generated] Run `node server/scripts/trakt-device-auth.js` after
# setting the three fields above. The script will append these tokens.
TRAKT_ACCESS_TOKEN=
TRAKT_REFRESH_TOKEN=
TRAKT_TOKEN_EXPIRES_AT=

# [OPTIONAL] Minimum delay between Trakt requests. Keep the default unless
# Trakt support asks you to change it.
TRAKT_MIN_REQUEST_INTERVAL_MS=5000


# --- Gmail IMAP poller ---

# [REQUIRED for auto-ingest; OPTIONAL otherwise]
# Leave both blank to skip the email poller entirely and run in
# manual-entry-only mode.
#
# How to get an app password:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Visit https://myaccount.google.com/apppasswords and generate one.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# [DO NOT TOUCH unless you have a special Gmail filter setup]
# Defaults: scans [Gmail]/All Mail for from:@amctheatres.com — no Gmail
# filter or label setup required. Override GMAIL_LABEL to scan a
# specific label instead.
GMAIL_LABEL=
GMAIL_AMC_FROM=amctheatres.com
